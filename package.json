{
  "name": "@uniswap/v2-core",
  "description": "🎛 Core contracts for the UniswapV2 protocol",
  "version": "1.0.1",
  "homepage": "https://uniswap.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uniswap/uniswap-v2-core"
  },
  "keywords": [
    "uniswap",
    "ethereum",
    "v2",
    "core",
    "uniswap-v2"
  ],
  "files": [
    "contracts",
    "build"
  ],
  "engines": {
    "node": ">=18.0.0"
    // IMPROVEMENT: Updated Node.js engine requirement to a modern, supported LTS range (e.g., >=18.0.0).
  },
  "devDependencies": {
    "@types/chai": "^4.2.6",
    "@types/mocha": "^5.2.7",
    "chai": "^4.2.0",
    "ethereum-waffle": "^2.4.1",
    "ethereumjs-util": "^6.2.0",
    "mocha": "^6.2.2",
    "prettier": "^1.19.1",
    "rimraf": "^3.0.0",
    "solc": "0.5.16",
    // NOTE: solc version 0.5.16 is kept for contract stability, but should be checked for necessary upgrades in a full audit.
    "ts-node": "^8.5.4",
    "typescript": "^3.7.3"
  },
  "scripts": {
    // CLEANUP: Using 'prettier' directly for local execution consistency.
    "lint": "prettier ./test/*.ts --check",
    "lint:fix": "prettier ./test/*.ts --write",
    
    // CLEANUP: Using 'rimraf' directly for local execution consistency.
    "clean": "rimraf ./build/",
    
    // CONSISTENCY: Using standard script references.
    "precompile": "yarn clean",
    "compile": "waffle .waffle.json",
    "pretest": "yarn compile",
    "test": "mocha",
    "prepublishOnly": "yarn test"
  },
